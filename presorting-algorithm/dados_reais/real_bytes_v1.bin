    \else
    \if@traditional%
        {\boldmath\if@large\fontsize{16bp}{18}\selectfont\else\if@medium\fontsize{16bp}{18}\selectfont\else\fontsize{12bp}{14}\selectfont\fi\fi\leftskip0pt plus1fill\rightskip0pt plus1fill \@author \par}%
    \else
